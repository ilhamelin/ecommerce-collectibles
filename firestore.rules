rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsDocument(id) {
      return signedIn() && (request.auth.uid == id ||
        (request.auth.token.email_verified == true && resource.data.email == request.auth.token.email));
    }
    // Catalogo y disenos publicados: lectura publica. Escrituras: API del servidor.
    match /products/{id} { allow read: if true; }
    match /custom_categories/{id} { allow read: if true; }
    match /branding_settings/{id} { allow read: if true; }
    match /slider_settings/{id} { allow read: if true; }
    match /announcement_settings/{id} { allow read: if true; }
    match /side_banners_settings/{id} { allow read: if true; }
    match /users/{id} { allow read: if ownsDocument(id); }
    match /orders/{id} {
      allow read: if signedIn() && request.auth.token.email_verified == true &&
        resource.data.customer.email == request.auth.token.email;
    }
    // Auditoria, versiones, cuotas y sesiones: servidor solamente.
    match /{document=**} { allow read, write: if false; }
  }
}
